{
  "name": "jci-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "api:types": "openapi-typescript contrat/openapi.yaml -o src/lib/api/schema.d.ts",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "openapi-typescript": "^7.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.0.0",
    "openapi-fetch": "^0.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
