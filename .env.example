# URL de l'API (sans /api/v1) — utilisée côté serveur (rendu) ET côté navigateur.
# Son origine est automatiquement autorisée dans la CSP (connect-src, img-src), http://localhost:3000 compris.
PUBLIC_API_URL=http://localhost:3000
# Clé publique Cloudflare Turnstile (tunnel d'achat)
PUBLIC_TURNSTILE_SITE_KEY=
# Site vers lequel renvoie la racine de la billetterie (défaut : https://jcicomee.org)
# PUBLIC_SITE_URL=https://jcicomee.org
# Facultatif : origine du stockage des billets (https://xxx.supabase.co) pour partager le visuel « J'y serai ! » en image depuis le téléphone
# PUBLIC_FILES_ORIGIN=
